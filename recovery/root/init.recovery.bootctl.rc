# DASH stock MTK recovery boot-control HAL with recovery userspace compat.
# Keep one service definition only; binary remains stock DASH PLATFORM authority.
service vendor.boot-default /system/bin/hw/android.hardware.boot-service.mtk_recovery
    class early_hal
    user root
    group root
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    setenv LD_PRELOAD /system/lib64/libdash_libcxx_compat.so
    seclabel u:r:hal_bootctl_default:s0
    interface aidl android.hardware.boot.IBootControl/default
