system /system erofs ro wait,slotselect,logical
system /system ext4 ro wait,slotselect,logical

system_ext /system_ext erofs ro wait,slotselect,logical
system_ext /system_ext ext4 ro wait,slotselect,logical

vendor /vendor erofs ro wait,slotselect,logical
vendor /vendor ext4 ro wait,slotselect,logical

product /product erofs ro wait,slotselect,logical
product /product ext4 ro wait,slotselect,logical

odm /odm erofs ro wait,slotselect,logical
odm /odm ext4 ro wait,slotselect,logical

vendor_dlkm /vendor_dlkm erofs ro wait,slotselect,logical
vendor_dlkm /vendor_dlkm ext4 ro wait,slotselect,logical

odm_dlkm /odm_dlkm erofs ro wait,slotselect,logical
odm_dlkm /odm_dlkm ext4 ro wait,slotselect,logical

system_dlkm /system_dlkm erofs ro wait,slotselect,logical,display="System DLKM"
system_dlkm /system_dlkm ext4 ro wait,slotselect,logical,display="System DLKM"

/dev/block/by-name/metadata /metadata f2fs noatime,nosuid,nodev,discard wait,check,formattable
/dev/block/by-name/userdata /data f2fs noatime,nosuid,nodev,discard,noflush_merge,fsync_mode=nobarrier,reserve_root=134217,resgid=1065,gc_merge,atgc,age_extent_cache,inlinecrypt wait,check,formattable,quota,resize,fileencryption=:aes-256-hctr2:inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption

/dev/block/by-name/rescue /cache ext4 noatime,nosuid,nodev,discard wait,backup=0,wipeingui=1
/dev/block/by-name/persist /persist ext4 noatime,nosuid,nodev wait

/devices/platform/soc/16701000.usb0/16700000.xhci* /usb_otg auto defaults display="USB-Storage";storage;wipeingui;removable

/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/init_boot /init_boot emmc defaults slotselect
/dev/block/by-name/vendor_boot /vendor_boot emmc defaults slotselect,backup,flashimg,display="Vendor Boot"
/dev/block/by-name/dtbo /dtbo emmc defaults slotselect,advbackup,flashimg,display="DTBO"
/dev/block/by-name/vbmeta /vbmeta emmc defaults slotselect,advbackup,flashimg,display="VBMeta"
/dev/block/by-name/vbmeta_system /vbmeta_system emmc defaults slotselect,advbackup,flashimg,display="VBMeta System"
/dev/block/by-name/vbmeta_vendor /vbmeta_vendor emmc defaults slotselect,advbackup,flashimg,display="VBMeta Vendor"
