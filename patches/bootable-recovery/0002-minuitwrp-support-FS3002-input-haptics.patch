From 2dce52b00df47f864903d5898b507bc0f0f69250 Mon Sep 17 00:00:00 2001
From: Raka Rizaldy <rakarizaldy-id@users.noreply.github.com>
Date: Wed, 9 Sep 2026 14:33:32 +0000
Subject: [PATCH] minuitwrp: support FS3002 input haptics

---
 minuitwrp/events.cpp | 33 +++++++++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/minuitwrp/events.cpp b/minuitwrp/events.cpp
index e497df62..9aa4b57b 100644
--- a/minuitwrp/events.cpp
+++ b/minuitwrp/events.cpp
@@ -145,6 +145,36 @@ int write_to_file(const std::string& fn, const std::string& line) {
 	return -1;
 }
 
+static bool try_fshaptic_vibrate(const char* timeout_ms) {
+    DIR* dir = opendir("/sys/class/input");
+    if (dir == nullptr) return false;
+
+    bool fired = false;
+    struct dirent* entry;
+    while ((entry = readdir(dir)) != nullptr) {
+        if (strncmp(entry->d_name, "input", 5) != 0) continue;
+
+        std::string input_path = std::string("/sys/class/input/") + entry->d_name;
+        std::ifstream name_file(input_path + "/name");
+        std::string name;
+        if (!std::getline(name_file, name) || name != "fshaptic") continue;
+
+        std::string device_path = input_path + "/device";
+        std::string duration = device_path + "/duration";
+        std::string activate = device_path + "/activate";
+        if (!std::ifstream(duration).good() || !std::ifstream(activate).good()) continue;
+
+        if (write_to_file(duration, timeout_ms) == 0 &&
+            write_to_file(activate, "1") == 0) {
+            fired = true;
+        }
+        break;
+    }
+
+    closedir(dir);
+    return fired;
+}
+
 #ifndef TW_NO_HAPTICS
 #ifndef TW_HAPTICS_TSPDRV
 int vibrate(int timeout_ms)
@@ -182,6 +212,9 @@ int vibrate(int timeout_ms)
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
 #else
+    if (try_fshaptic_vibrate(tout)) {
+        return 0;
+    }
     if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
         write_to_file(LEDS_HAPTICS_ACTIVATE_FILE, "1");
-- 
