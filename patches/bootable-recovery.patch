-#ifdef USE_QTI_AIDL_HAPTICS_FIX_OFF
 #include <thread>
-#endif
+#include <mutex>
+#include <atomic>
 
 #ifdef USE_QTI_HAPTICS
 #include <android/hardware/vibrator/1.2/IVibrator.h>
@@ -145,6 +146,95 @@ int write_to_file(const std::string& fn, const std::string& line) {
 	return -1;
 }
 
+static std::mutex fs3002_ff_mutex;
+static int fs3002_ff_fd = -1;
+static int fs3002_ff_effect_id = -1;
+static std::atomic<unsigned long long> fs3002_ff_generation{0};
+
+static bool init_fs3002_ff_locked() {
+    if (fs3002_ff_fd >= 0)
+        return true;
+
+    for (int i = 0; i < MAX_DEVICES; ++i) {
+        char path[64];
+        char name[128] = {};
+        snprintf(path, sizeof(path), "/dev/input/event%d", i);
+
+        int fd = open(path, O_RDWR | O_CLOEXEC);
+        if (fd < 0)
+            continue;
+
+        if (ioctl(fd, EVIOCGNAME(sizeof(name)), name) < 0 || strcmp(name, "fshaptic") != 0) {
+            close(fd);
+            continue;
+        }
+
+        struct input_event gain = {};
+        gain.type = EV_FF;
+        gain.code = FF_GAIN;
+        gain.value = 0xffff;
+        if (write(fd, &gain, sizeof(gain)) != sizeof(gain))
+            LOGI("FS3002: failed to set gain on %s\n", path);
+
+        fs3002_ff_fd = fd;
+        LOGI("FS3002: cached haptic device %s\n", path);
+        return true;
+    }
+
+    return false;
+}
+
+static bool vibrate_fs3002_ff(int timeout_ms) {
+    std::lock_guard<std::mutex> lock(fs3002_ff_mutex);
+    if (!init_fs3002_ff_locked())
+        return false;
+
+    if (fs3002_ff_effect_id >= 0) {
+        struct input_event stop = {};
+        stop.type = EV_FF;
+        stop.code = fs3002_ff_effect_id;
+        stop.value = 0;
+        write(fs3002_ff_fd, &stop, sizeof(stop));
+    }
+
+    struct ff_effect effect = {};
+    effect.type = FF_CONSTANT;
+    effect.id = fs3002_ff_effect_id;
+    effect.replay.length = static_cast<__u16>(timeout_ms);
+    effect.u.constant.level = 0x7fff;
+
+    if (ioctl(fs3002_ff_fd, EVIOCSFF, &effect) < 0) {
+        LOGI("FS3002: EVIOCSFF failed on cached device\n");
+        return false;
+    }
+    fs3002_ff_effect_id = effect.id;
+
+    struct input_event play = {};
+    play.type = EV_FF;
+    play.code = fs3002_ff_effect_id;
+    play.value = 1;
+    if (write(fs3002_ff_fd, &play, sizeof(play)) != sizeof(play)) {
+        LOGI("FS3002: failed to start cached effect\n");
+        return false;
+    }
+
+    const unsigned long long generation = ++fs3002_ff_generation;
+    std::thread([generation, timeout_ms]() {
+        usleep(timeout_ms * 1000);
+        if (fs3002_ff_generation.load() != generation)
+            return;
+        std::lock_guard<std::mutex> lock(fs3002_ff_mutex);
+        if (fs3002_ff_generation.load() != generation || fs3002_ff_fd < 0 || fs3002_ff_effect_id < 0)
+            return;
+        struct input_event stop = {};
+        stop.type = EV_FF;
+        stop.code = fs3002_ff_effect_id;
+        stop.value = 0;
+        write(fs3002_ff_fd, &stop, sizeof(stop));
+    }).detach();
+    return true;
+}
+
 #ifndef TW_NO_HAPTICS
 #ifndef TW_HAPTICS_TSPDRV
 int vibrate(int timeout_ms)
@@ -182,6 +272,9 @@ int vibrate(int timeout_ms)
         write_to_file(VIBRATOR_TIMEOUT_FILE, tout);
     }
 #else
+    if (vibrate_fs3002_ff(timeout_ms)) {
+        return 0;
+    }
     if (std::ifstream(LEDS_HAPTICS_ACTIVATE_FILE).good()) {
         write_to_file(LEDS_HAPTICS_DURATION_FILE, tout);
