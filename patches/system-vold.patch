+bool Weaver::WeaverVerify(const uint32_t slot, const void* weaver_key,
+                          std::vector<uint8_t>* payload) {
+    if (!mDevice) return false;
+
+    uint32_t keySize = 0;
+    if (!GetKeySize(&keySize)) return false;
+
+    const auto* ptr = static_cast<const uint8_t*>(weaver_key);
+    std::vector<uint8_t> key(ptr, ptr + keySize);
+    WeaverReadResponse response;
+    auto ret = mDevice->read(static_cast<int32_t>(slot), key, &response);
+    if (!ret.isOk()) {
+        std::cout << "DASH_WEAVER: read failed slot=" << slot
+                  << " exception=" << ret.getExceptionCode()
+                  << " service_error=" << ret.getServiceSpecificError()
+                  << " timeout=" << response.timeout << std::endl;
+        return false;
+    }
+    if (response.timeout != 0) {
+        std::cout << "DASH_WEAVER: read throttled slot=" << slot
+                  << " timeout=" << response.timeout << std::endl;
+        return false;
+    }
+
+    *payload = response.value;
+    std::cout << "DASH_WEAVER: read success slot=" << slot
+              << " payload_size=" << payload->size() << std::endl;
