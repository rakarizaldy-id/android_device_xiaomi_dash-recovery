 static bool fscryptKeyring(key_serial_t* device_keyring) {
     *device_keyring = keyctl_search(KEY_SPEC_SESSION_KEYRING, "keyring", "fscrypt", 0);
-    if (*device_keyring == -1) {
+    if (*device_keyring != -1) {
+        return true;
+    }
+
+    const int search_errno = errno;
+    if (search_errno != ENOKEY) {
+        errno = search_errno;
         PLOG(ERROR) << "Unable to find device keyring";
         return false;
     }
+
+    // Recovery does not execute Android init's `installkey` builtin.
+    // Create the same session-level fscrypt keyring here so provisioning
+    // keys can be retained after FS_IOC_ADD_ENCRYPTION_KEY succeeds.
+    *device_keyring = add_key("keyring", "fscrypt", nullptr, 0, KEY_SPEC_SESSION_KEYRING);
+    if (*device_keyring == -1) {
+        PLOG(ERROR) << "DASH_FSCRYPT: failed to create fscrypt session keyring";
+        return false;
+    }
+    LOG(INFO) << "DASH_FSCRYPT: created fscrypt session keyring id=" << *device_keyring;
     return true;
 }
 
